# BASE_URL에는 도메인이 아니라 엔드포인트 전체 주소를 넣는다 (클라이언트는 쿼리 파라미터만 붙인다)
# 온통청년: https://www.youthcenter.go.kr/go/ythip/getPlcy
# 서민금융상품(금융위원회): https://apis.data.go.kr/1160100/service/GetSmallLoanFinanceInstituteInfoService/getOrdinaryFinanceInfo
YOUTH_CENTER_API_KEY=
YOUTH_CENTER_BASE_URL=
KINFA_API_KEY=
KINFA_BASE_URL=

# postgres:16 이미지는 빈 비밀번호를 허용하지 않으므로 반드시 실제 값을 채워야 함
DB_NAME=fintarget
DB_USERNAME=moon
DB_PASSWORD=

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 화면의 "앱 ID"(숫자, REST API 키 아님) (#218)
# 로그인할 때 카카오 토큰이 이 앱에서 발급됐는지 확인한다. 비우면 확인하지 않으므로 운영에서는 반드시 채운다
KAKAO_APP_ID=
JWT_SECRET=

# 리프레시 토큰을 재발급할 때 사용한 토큰을 바로 무효화할지 (#218). iOS가 재발급 응답의 refreshToken을 저장하도록
# 업데이트된 뒤에 true로 바꾼다. 그 전에 켜면 이전 토큰을 계속 쓰는 앱이 로그아웃된다
JWT_REVOKE_USED_REFRESH_TOKEN=false

# Swagger 문서(/swagger-ui, /v3/api-docs) Basic Auth 계정 (#218). 비우면 문서를 공개한다
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# HTTPS (#218). DOMAIN을 채우면 scripts/deploy.sh가 Caddy를 띄워 Let's Encrypt 인증서를 자동 발급한다
# DNS가 서버 IP를 가리키고 보안 그룹에서 80·443이 열려 있어야 한다. 도메인이 없으면 <IP를 -로 이은 값>.sslip.io도 쓸 수 있다
DOMAIN=
# 앱이 HTTPS 주소로 옮긴 뒤 127.0.0.1로 바꿔 8080을 외부에서 막는다. 비우면 전체 공개(0.0.0.0)
APP_BIND_ADDRESS=

# 관리자 API(/api/admin/**) 호출용 키. X-Admin-Key 헤더로 전송. 비어 있으면 관리자 API는 모두 403
# 생성 예: openssl rand -hex 32
ADMIN_API_KEY=

# 가상 금융 서버(mock-bank) 웹훅(/api/webhooks/**) 인증 키. X-Bank-Webhook-Key 헤더로 전송. 비어 있으면 웹훅은 모두 403
# mock-bank의 FINTARGET_WEBHOOK_KEY와 같은 값을 넣는다. 생성 예: openssl rand -hex 32
BANK_WEBHOOK_KEY=

# 운영 서버에 함께 띄우는 mock-bank(#204)의 화면 로그인(Basic Auth) 계정. 웹훅 키는 위 BANK_WEBHOOK_KEY를 그대로 쓴다
# 비어 있으면 scripts/deploy.sh가 mock-bank를 띄우지 않는다. 다른 곳에서 쓰지 않는 비밀번호를 사용한다
MOCK_BANK_USERNAME=
MOCK_BANK_PASSWORD=
# DOMAIN이 있으면 mock-bank는 https://bank.<DOMAIN>으로도 열린다 (#230). 그 주소로 옮긴 뒤 127.0.0.1로 바꿔 8081을 외부에서 막는다
MOCK_BANK_BIND_ADDRESS=

# OpenAI API 키 (#114). 비어 있으면 서버는 정상 기동하고 AI 질문 기능만 503으로 응답
# 기본 모델: 지정하지 않으면 코드 기본값 gpt-6-luna. 정책 AI 질문(#125)은 기본 모델만 쓴다
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=
# 상위 모델: 지정하지 않으면 코드 기본값 gpt-6.1-sol. 추천 목록 LLM 리랭킹(#229)에만 쓴다
OPENAI_MODEL_PREMIUM=

# 추천 목록 LLM 리랭킹 (#229). 비우면 true. false면 LLM을 호출하지 않고 규칙 기반 상위 N건을 반환한다
# 바꾼 뒤 `docker compose up -d --no-deps app`으로 앱 컨테이너를 다시 만들어야 반영된다 (재빌드 불필요, 메모리 캐시는 비워짐)
# 재시작 없이 바로 끄려면 관리자 API: PUT /api/admin/policy/recommend/rerank/enabled?enabled=false (재시작하면 이 값으로 돌아감)
POLICY_RECOMMEND_RERANK_ENABLED=

# 캐시가 없을 때 추천 목록 조회가 LLM 리랭킹을 기다리는 최대 시간 (#257). 비우면 30s (이전 20s에서 늘림)
# 진행 중인 미리 계산을 기다릴 때도 같은 값을 쓴다 (#243). 넘기면 규칙 기반 상위 N건을 먼저 보여 준다
POLICY_RECOMMEND_RERANK_TIMEOUT=

# 시뮬레이션 주거 정책 월 절감액 추정 (#257). 비우면 켜짐
# 금액이 없던 주거 정책(기숙사형 청년주택, 청년안심주택, 통합공공임대, 대학생 연합생활관)을 공식 기준값으로 추정해
# 시뮬레이션 "정책 반영 달성일"이 나오게 한다. DB에 쓰지 않아 끄면 바로 기존 동작으로 돌아간다
SIMULATION_SAVING_ESTIMATE_ENABLED=
# false면 추천 목록·스크랩 응답의 simulationBenefit에는 넣지 않고 시뮬레이션 실행에서만 반영한다. 비우면 true
# 앱은 이 값이 있어야 정책 상세에 "목표 달성일 확인하기" 버튼을 보여 주므로 보통 비워 둔다
SIMULATION_SAVING_ESTIMATE_EXPOSE_IN_POLICY_RESPONSES=
# 추정 기준 월세(원). 비우면 620000 (다방, 서울 주요 10개 대학 인근 원룸 평균 월세 62.2만원, 2026-01)
SIMULATION_SAVING_ESTIMATE_BASE_RENT=

# 직접 등록 정책(희망두배 청년통장 등, #245)을 직업 유형에 맞는 사용자의 추천 목록 맨 앞에 고정 노출. 비우면 true
# false면 고정 없이 기존 추천 결과 그대로. 바꾼 뒤 `docker compose up -d --no-deps app`으로 앱 컨테이너를 다시 만든다
POLICY_RECOMMEND_MANUAL_PIN_ENABLED=

# 통합 답변·검색의 사용자별 하루 호출 수 (#239). 비우면 0 = 무제한 (부스 시연에서 계정 몇 개를 여러 방문자가 나눠 쓰기 때문)
# 다시 걸려면 각각 20, 50처럼 양수를 넣는다. 무제한일 때는 사용량을 세지 않아 429가 나지 않는다
POLICY_RAG_DAILY_LIMIT=
POLICY_SEARCH_DAILY_LIMIT=

# 통합 답변 검색 문장 바꿔 쓰기 (#241). 비우면 true. 구어체 질문을 기본 모델로 검색 문장으로 바꿔 한 번 더 검색한다
# false면 원래 질문으로만 검색한다. 바꾼 뒤 `docker compose up -d --no-deps app`으로 앱 컨테이너를 다시 만든다
POLICY_RAG_QUERY_REWRITE_ENABLED=

# 검색 문장 바꿔 쓰기 응답을 기다리는 최대 시간 (#245). 비우면 5s. 예: 5s, 4000ms
POLICY_RAG_QUERY_REWRITE_TIMEOUT=

# 부스 시연용 계정 초기화 API (#239). 비우면 false이고, false면 아래 API 3개가 모두 404다
#   POST /api/users/me/demo-reset                 앱의 초기화 버튼 (로그인한 본인만, 지출은 남김)
#   POST /api/admin/demo/users/{userId}/reset     비상용 (X-Admin-Key)
#   GET  /api/admin/demo/users                    비상용 사용자 확인 (X-Admin-Key)
# 시연 때만 true로 두고, 끝나면 비운 뒤 `docker compose up -d --no-deps app`으로 앱 컨테이너를 다시 만든다
DEMO_RESET_ENABLED=

# JPA 스키마 처리 방식 (#219). 비우면 validate(엔티티와 DB가 다르면 앱이 뜨지 않음, 스키마는 바꾸지 않음)
# docs/sql/ 마이그레이션을 아직 적용하지 못해 급하게 띄워야 할 때만 update로 바꾸고, 적용 후 다시 비운다
JPA_DDL_AUTO=
