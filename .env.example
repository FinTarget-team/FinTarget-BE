# BASE_URL에는 도메인이 아니라 엔드포인트 전체 주소를 넣는다 (클라이언트는 쿼리 파라미터만 붙인다)
# 온통청년: https://www.youthcenter.go.kr/go/ythip/getPlcy
# 서민금융상품(금융위원회): https://apis.data.go.kr/1160100/service/GetSmallLoanFinanceInstituteInfoService/getOrdinaryFinanceInfo
YOUTH_CENTER_API_KEY=
YOUTH_CENTER_BASE_URL=
KINFA_API_KEY=
KINFA_BASE_URL=

# postgres:16 이미지는 빈 비밀번호를 허용하지 않으므로 반드시 실제 값을 채워야 함
DB_NAME=fintarget
DB_USERNAME=moon
DB_PASSWORD=

# 카카오 개발자 콘솔의 REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
JWT_SECRET=

# 관리자 API(/api/admin/**) 호출용 키. X-Admin-Key 헤더로 전송. 비어 있으면 관리자 API는 모두 403
# 생성 예: openssl rand -hex 32
ADMIN_API_KEY=

# OpenAI API 키 (#114). 비어 있으면 서버는 정상 기동하고 AI 질문 기능만 503으로 응답
# 기본 모델: 지정하지 않으면 코드 기본값 gpt-6-luna. 정책 AI 질문(#125)은 기본 모델만 쓴다
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=gpt-6.1-sol
