# BASE_URL에는 도메인이 아니라 엔드포인트 전체 주소를 넣는다 (클라이언트는 쿼리 파라미터만 붙인다)
# 온통청년: https://www.youthcenter.go.kr/go/ythip/getPlcy
# 서민금융상품(금융위원회): https://apis.data.go.kr/1160100/service/GetSmallLoanFinanceInstituteInfoService/getOrdinaryFinanceInfo
YOUTH_CENTER_API_KEY=
YOUTH_CENTER_BASE_URL=
KINFA_API_KEY=
KINFA_BASE_URL=

# postgres:16 이미지는 빈 비밀번호를 허용하지 않으므로 반드시 실제 값을 채워야 함
DB_NAME=fintarget
DB_USERNAME=moon
DB_PASSWORD=

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 화면의 "앱 ID"(숫자, REST API 키 아님) (#218)
# 로그인할 때 카카오 토큰이 이 앱에서 발급됐는지 확인한다. 비우면 확인하지 않으므로 운영에서는 반드시 채운다
KAKAO_APP_ID=
JWT_SECRET=

# 리프레시 토큰을 재발급할 때 사용한 토큰을 바로 무효화할지 (#218). iOS가 재발급 응답의 refreshToken을 저장하도록
# 업데이트된 뒤에 true로 바꾼다. 그 전에 켜면 이전 토큰을 계속 쓰는 앱이 로그아웃된다
JWT_REVOKE_USED_REFRESH_TOKEN=false

# Swagger 문서(/swagger-ui, /v3/api-docs) Basic Auth 계정 (#218). 비우면 문서를 공개한다
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# HTTPS (#218). DOMAIN을 채우면 scripts/deploy.sh가 Caddy를 띄워 Let's Encrypt 인증서를 자동 발급한다
# DNS가 서버 IP를 가리키고 보안 그룹에서 80·443이 열려 있어야 한다. 도메인이 없으면 <IP를 -로 이은 값>.sslip.io도 쓸 수 있다
DOMAIN=
# 앱이 HTTPS 주소로 옮긴 뒤 127.0.0.1로 바꿔 8080을 외부에서 막는다. 비우면 전체 공개(0.0.0.0)
APP_BIND_ADDRESS=

# 관리자 API(/api/admin/**) 호출용 키. X-Admin-Key 헤더로 전송. 비어 있으면 관리자 API는 모두 403
# 생성 예: openssl rand -hex 32
ADMIN_API_KEY=

# 가상 금융 서버(mock-bank) 웹훅(/api/webhooks/**) 인증 키. X-Bank-Webhook-Key 헤더로 전송. 비어 있으면 웹훅은 모두 403
# mock-bank의 FINTARGET_WEBHOOK_KEY와 같은 값을 넣는다. 생성 예: openssl rand -hex 32
BANK_WEBHOOK_KEY=

# 운영 서버에 함께 띄우는 mock-bank(#204)의 화면 로그인(Basic Auth) 계정. 웹훅 키는 위 BANK_WEBHOOK_KEY를 그대로 쓴다
# 비어 있으면 scripts/deploy.sh가 mock-bank를 띄우지 않는다. 다른 곳에서 쓰지 않는 비밀번호를 사용한다
MOCK_BANK_USERNAME=
MOCK_BANK_PASSWORD=
# DOMAIN이 있으면 mock-bank는 https://bank.<DOMAIN>으로도 열린다 (#230). 그 주소로 옮긴 뒤 127.0.0.1로 바꿔 8081을 외부에서 막는다
MOCK_BANK_BIND_ADDRESS=

# OpenAI API 키 (#114). 비어 있으면 서버는 정상 기동하고 AI 질문 기능만 503으로 응답
# 기본 모델: 지정하지 않으면 코드 기본값 gpt-6-luna. 정책 AI 질문(#125)은 기본 모델만 쓴다
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=

# JPA 스키마 처리 방식 (#219). 비우면 validate(엔티티와 DB가 다르면 앱이 뜨지 않음, 스키마는 바꾸지 않음)
# docs/sql/ 마이그레이션을 아직 적용하지 못해 급하게 띄워야 할 때만 update로 바꾸고, 적용 후 다시 비운다
JPA_DDL_AUTO=
