# HTTPS 리버스 프록시 (#218). .env의 DOMAIN으로 Let's Encrypt 인증서를 자동 발급·갱신하고 앱(app:8080)으로 전달한다.
# 인증서 발급에는 DOMAIN의 DNS가 이 서버 IP를 가리키고, 보안 그룹에서 80·443 포트가 열려 있어야 한다.
# 프록시가 X-Forwarded-For·X-Forwarded-Proto를 붙이고, 앱은 server.forward-headers-strategy=native로 실제 클라이언트 IP를 쓴다.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# SSE(/api/events/stream)는 text/event-stream 응답이라 Caddy가 버퍼링 없이 바로 흘려보낸다
	reverse_proxy app:8080
}

# 가상 금융 서버(mock-bank) 화면. Basic Auth 비밀번호가 평문으로 오가지 않도록 HTTPS로만 연다 (#230)
# sslip.io처럼 와일드카드 DNS면 bank.<도메인>도 같은 서버를 가리킨다. 직접 산 도메인이면 bank 레코드를 추가해야 한다
bank.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy mock-bank:8081
}
